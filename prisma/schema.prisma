generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
  ACCOUNTANT
  HR_OFFICER
  SALES_PERSON
  WAREHOUSE_CLERK
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  VOIDED
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
}

enum StockAdjustmentReason {
  RESTOCK
  MANUAL_INCREASE
  MANUAL_DECREASE
  DAMAGED
  RETURNED
  EXPIRED
  PURCHASE_RECEIVED // ← new: stock received via purchase invoice
  PURCHASE_RETURN // ← new: stock returned to supplier via purchase return
}

enum ExpensePaymentMethod {
  CASH
  MPESA
  CARD
  BANK_TRANSFER
}

enum ExpenseFrequency {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ActivityAction {
  ORDER_CREATED
  ORDER_CANCELLED
  ORDER_COMPLETED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  STOCK_ADJUSTED
  STOCK_BULK_ADJUSTED
  USER_CREATED
  USER_UPDATED
  USER_ROLE_CHANGED
  USER_ACTIVATED
  USER_DEACTIVATED
  USER_LOGIN
  USER_LOGOUT
  USER_DELETE
  SETTINGS_UPDATED
  PERMISSIONS_UPDATED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
  BRANCH_CREATED
  BRANCH_UPDATED
  BRANCH_USER_ASSIGNED
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  RECEIPT_VOIDED
  RECEIPT_COMBINED
  RECEIPT_REPRINTED
  USER_DELETED
  SUPPLIER_CREATED
  SUPPLIER_UPDATED
  PURCHASE_CREATED
  PURCHASE_RECEIVED
  PURCHASE_CANCELLED
}

enum NotificationType {
  NEW_ORDER
  ORDER_CANCELLED
  LOW_STOCK
  OUT_OF_STOCK
  MPESA_PENDING
  MPESA_SUCCESS
  MPESA_FAILED
  EXPENSE_ADDED
  USER_ACTION
  SYSTEM
}

enum LoyaltyLogType {
  EARNED
  REDEEMED
  ADJUSTED
  EXPIRED
}

enum LayawayStatus {
  ACTIVE // deposit paid, product held
  COMPLETED // fully paid, order completed
  EXPIRED // time ran out, stock returned
  CANCELLED // manually cancelled
}

enum ReceiptStatus {
  ACTIVE // normal, valid receipt
  VOIDED // voided — stock returned
  COMBINED // this receipt was merged into another
  DUPLICATE // reprint of an existing receipt
}

enum ReceiptType {
  SALE // standard sale receipt
  RETURN // return/refund receipt
  COMBINED // merged from multiple receipts
  DUPLICATE // copy of original
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseStatus {
  DRAFT // created, not yet ordered
  ORDERED // sent to supplier, awaiting delivery
  PARTIAL // partially received
  RECEIVED // fully received
  CANCELLED // cancelled
}

enum PurchasePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum JournalEntrySource {
  MANUAL
  SALE
  PURCHASE
  EXPENSE
  PAYMENT
  PAYROLL
  STOCK_ADJUSTMENT
  OPENING_BALANCE
  DEPRECIATION
  TRANSFER
}

// ── Sales Pipeline Enums ──────────────────────────────────────────────────────

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DELIVERED
  FULLY_DELIVERED
  INVOICED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  PARTIAL
  DELIVERED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum SalesReturnStatus {
  PENDING
  APPROVED
  RECEIVED
  REFUNDED
}

// ── Branch ────────────────────────────────────────────────────────────────────
// Defined first — everything else references it

model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  products            Product[]
  categories          Category[]
  orders              Order[]
  expenses            Expense[]
  customers           Customer[]
  stocks              Stock[]
  expenseCategories   ExpenseCategory[]
  mpesaTransactions   MpesaTransaction[]
  layaways            Layaway[]
  receipts            Receipt[]
  suppliers           Supplier[]
  purchases           Purchase[]
  accountings         Accounting[]
  journalEntries      JournalEntry[]
  leads               Lead[]
  opportunities       Opportunity[]
  assets              Asset[]
  documents           Document[]
  accountsReceivables AccountsReceivable[]
  accountsPayables    AccountsPayable[]
  fixedAssets         FixedAsset[]
  bankAccounts        BankAccount[]
  quotations          Quotation[]
  salesOrders         SalesOrder[]
  deliveryNotes       DeliveryNote[]
  invoices            Invoice[]
  salesReturns        SalesReturn[]
}

// ── Auth ──────────────────────────────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  role          UserRole @default(CASHIER)
  emailVerified Boolean  @default(false)
  image         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  phone        String?
  departmentId String? // Link to HR Department
  positionId   String? // Link to HR Position
  hireDate     DateTime?
  salary       Float? // Base salary for Payroll

  // null = ADMIN (global), required for MANAGER + CASHIER
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  sessions      Session[]
  accounts      Account[]
  orders        Order[]
  expenses      Expense[]
  activityLogs  ActivityLog[]
  notifications Notification[]
  layaways      Layaway[]

  username                 String?
  displayUsername          String?
  receipts                 Receipt[]
  voidedReceipts           Receipt[]         @relation("ReceiptVoidedBy")
  stockLogs                StockLog[]
  purchases                Purchase[]
  journalEntries           JournalEntry[]
  postedJournalEntries     JournalEntry[]    @relation("JournalPostedBy")
  reversedJournalEntries   JournalEntry[]    @relation("JournalReversedBy")
  leads                    Lead[]
  department               Department?       @relation(fields: [departmentId], references: [id])
  position                 Position?         @relation(fields: [positionId], references: [id])
  leaveRequests            LeaveRequest[]
  approvedLeaveRequests    LeaveRequest[]    @relation("LeaveApprover")
  attendances              Attendance[]
  payrolls                 Payroll[]
  assets                   Asset[]
  projectTasks             ProjectTask[]
  documents                Document[]
  approvalRequests         ApprovalRequest[] @relation("ApprovalRequester")
  approvedApprovalRequests ApprovalRequest[] @relation("ApprovalApprover")
  quotations               Quotation[]
  salesOrders              SalesOrder[]
  deliveryNotes            DeliveryNote[]
  invoices                 Invoice[]
  salesReturns             SalesReturn[]

  @@unique([username])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  role     String?
  isActive Boolean?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ── Products & Categories ─────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String?
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  products Product[]

  // name unique per branch
  @@unique([name, branchId])
}

model Product {
  id               String    @id @default(cuid())
  name             String
  sku              String
  barcode          String?   @unique
  qrCode           String? // For QR Code scanning
  batchNumber      String? // For Batch tracking
  expiryDate       DateTime? // For Expiry tracking
  unit             String?   @default("pcs") // e.g., kg, box, pcs
  brand            String? // For Brand management
  price            Float
  lastPrice        Float     @default(0)
  costPrice        Float     @default(0)
  costPriceInclTax Float     @default(0) // ← new: cost price inclusive of tax
  purchaseTaxRate  Float     @default(0) // tax rate % applied to purchase price
  imageUrl         String?
  isActive         Boolean   @default(true)
  discountRate     Float     @default(0)
  taxRate          Float     @default(0)
  branchId         String?
  categoryId       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category          Category?          @relation(fields: [categoryId], references: [id])
  orderItems        OrderItem[]
  stock             Stock?
  layawayItems      LayawayItem[]
  purchaseItems     PurchaseItem[]
  quotationItems    QuotationItem[]
  salesOrderItems   SalesOrderItem[]
  deliveryNoteItems DeliveryNoteItem[]
  invoiceItems      InvoiceItem[]
  salesReturnItems  SalesReturnItem[]

  // SKU unique per branch
  @@unique([sku, branchId])
}

// ── Orders ────────────────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  orderNumber String
  status      OrderStatus @default(PENDING)
  subtotal    Float
  discount    Float       @default(0)
  tax         Float       @default(0)
  total       Float
  amountPaid  Float? // Total amount paid
  change      Float? // Change given
  note        String?
  branchId    String?
  userId      String?
  customerId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  branch   Branch?     @relation(fields: [branchId], references: [id])
  user     User?       @relation(fields: [userId], references: [id])
  customer Customer?   @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  payment  Payment?
  receipt  Receipt?

  @@unique([orderNumber, branchId])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  productName String
  sku         String
  quantity    Int
  unitPrice   Float
  total       Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id        String   @id @default(cuid())
  orderId   String   @unique
  // method     PaymentMethod
  amount    Float
  // mpesaRef   String?
  // mpesaPhone String?
  createdAt DateTime @default(now())

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  splitPayments SplitPayment[]
}

model SplitPayment {
  id         String        @id @default(cuid())
  paymentId  String
  method     PaymentMethod
  amount     Float
  mpesaRef   String?
  mpesaPhone String?
  createdAt  DateTime      @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

// ── Inventory ─────────────────────────────────────────────────────────────────

model Stock {
  id         String   @id @default(cuid())
  productId  String   @unique
  branchId   String?
  quantity   Int      @default(0)
  lowStockAt Int      @default(10)
  updatedAt  DateTime @updatedAt

  branch  Branch?    @relation(fields: [branchId], references: [id])
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  logs    StockLog[]
}

model StockLog {
  id             String                @id @default(cuid())
  stockId        String
  productId      String
  reason         StockAdjustmentReason
  quantityBefore Int
  quantityAfter  Int
  change         Int
  note           String?
  createdAt      DateTime              @default(now())
  userId         String?
  user           User?                 @relation(fields: [userId], references: [id])

  purchaseItemId String?

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)
}

// ── M-Pesa ────────────────────────────────────────────────────────────────────

model MpesaTransaction {
  id                 String   @id @default(cuid())
  checkoutRequestId  String   @unique
  merchantRequestId  String
  phoneNumber        String
  amount             Float
  status             String   @default("PENDING")
  mpesaReceiptNumber String?
  resultCode         Int?
  resultDesc         String?
  orderId            String?
  branchId           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id])
}

// ── Expenses ──────────────────────────────────────────────────────────────────

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId String?

  branch   Branch?   @relation(fields: [branchId], references: [id])
  expenses Expense[]
}

model Expense {
  id            String               @id @default(cuid())
  title         String
  amount        Float
  date          DateTime
  note          String?
  receiptUrl    String?
  paymentMethod ExpensePaymentMethod @default(CASH)
  frequency     ExpenseFrequency     @default(ONE_TIME)
  isRecurring   Boolean              @default(false)
  branchId      String?
  categoryId    String?
  userId        String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  branch   Branch?          @relation(fields: [branchId], references: [id])
  category ExpenseCategory? @relation(fields: [categoryId], references: [id])
  user     User?            @relation(fields: [userId], references: [id])
}

// ── CRM ───────────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  points    Int      @default(0)
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch              Branch?              @relation(fields: [branchId], references: [id])
  orders              Order[]
  pointLogs           LoyaltyLog[]
  layaways            Layaway[]
  receipts            Receipt[]
  opportunities       Opportunity[]
  accountsReceivables AccountsReceivable[]
  quotations          Quotation[]
  salesOrders         SalesOrder[]
  invoices            Invoice[]
  salesReturns        SalesReturn[]

  // phone unique per branch
  // email unique per branch
  @@unique([phone, branchId])
  @@unique([email, branchId])
}

model LoyaltyLog {
  id          String         @id @default(cuid())
  customerId  String
  orderId     String?
  points      Int
  type        LoyaltyLogType
  description String?
  createdAt   DateTime       @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Lead {
  id           String   @id @default(cuid())
  name         String
  email        String?
  phone        String?
  source       String? // e.g., "Walk-in", "Website", "Referral"
  status       String   @default("NEW") // NEW, CONTACTED, QUALIFIED, LOST
  branchId     String?
  assignedToId String?
  createdAt    DateTime @default(now())

  branch        Branch?       @relation(fields: [branchId], references: [id])
  assignedTo    User?         @relation(fields: [assignedToId], references: [id])
  opportunities Opportunity[]
}

model Opportunity {
  id         String   @id @default(cuid())
  title      String
  value      Float
  stage      String   @default("PROSPECTING") // PROSPECTING, QUALIFICATION, PROPOSAL, NEGOTIATION, CLOSED_WON, CLOSED_LOST
  customerId String?
  leadId     String?
  branchId   String?
  createdAt  DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id])
  lead     Lead?     @relation(fields: [leadId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])
}

model Department {
  id       String  @id @default(cuid())
  name     String
  branchId String?
  users    User[]
}

model Position {
  id           String  @id @default(cuid())
  title        String
  departmentId String?
  users        User[]
}

model LeaveRequest {
  id           String   @id @default(cuid())
  userId       String
  type         String // ANNUAL, SICK, MATERNITY
  startDate    DateTime
  endDate      DateTime
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reason       String?
  approvedById String?
  createdAt    DateTime @default(now())

  user       User  @relation(fields: [userId], references: [id])
  approvedBy User? @relation("LeaveApprover", fields: [approvedById], references: [id])
}

model Attendance {
  id        String    @id @default(cuid())
  userId    String
  date      DateTime  @default(now())
  checkIn   DateTime?
  checkOut  DateTime?
  status    String    @default("PRESENT") // PRESENT, ABSENT, LATE, ON_LEAVE
  method    String? // BIOMETRIC, QR, GPS, MANUAL
  latitude  Float?
  longitude Float?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model Payroll {
  id         String   @id @default(cuid())
  userId     String
  month      Int
  year       Int
  basicPay   Float
  allowances Float    @default(0)
  deductions Float    @default(0) // PAYE, NSSF, NHIF
  netPay     Float
  status     String   @default("DRAFT") // DRAFT, PAID
  payslipUrl String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ── System ────────────────────────────────────────────────────────────────────

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("")
  group     String
  label     String
  type      String   @default("text")
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  group       String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(cuid())
  role         String
  permissionId String
  createdAt    DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model ActivityLog {
  id          String         @id @default(cuid())
  action      ActivityAction
  entity      String
  entityId    String?
  entityLabel String?
  meta        Json?
  userId      String?
  branchId    String? // which branch this activity belongs to
  createdAt   DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  userId    String?
  roles     String[]         @default([])
  meta      Json?
  createdAt DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([createdAt])
}

model Layaway {
  id            String        @id @default(cuid())
  orderNumber   String
  branchId      String
  customerId    String?
  userId        String?
  depositAmount Float
  totalAmount   Float
  balanceAmount Float
  dueDate       DateTime // deadline to pay in full
  status        LayawayStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  branch   Branch           @relation(fields: [branchId], references: [id])
  customer Customer?        @relation(fields: [customerId], references: [id])
  user     User?            @relation(fields: [userId], references: [id])
  items    LayawayItem[]
  payments LayawayPayment[]
}

model LayawayItem {
  id          String @id @default(cuid())
  layawayId   String
  productId   String
  productName String
  sku         String
  quantity    Int
  unitPrice   Float
  total       Float

  layaway Layaway @relation(fields: [layawayId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model LayawayPayment {
  id        String        @id @default(cuid())
  layawayId String
  amount    Float
  method    PaymentMethod
  mpesaRef  String?
  note      String?
  createdAt DateTime      @default(now())

  layaway Layaway @relation(fields: [layawayId], references: [id], onDelete: Cascade)
}

model Receipt {
  id            String        @id @default(cuid())
  receiptNumber String
  orderId       String?       @unique // null for combined receipts
  branchId      String?
  userId        String? // cashier who issued it
  customerId    String?
  type          ReceiptType   @default(SALE)
  status        ReceiptStatus @default(ACTIVE)

  // Financial snapshot at time of issue
  subtotal Float
  discount Float @default(0)
  tax      Float @default(0)
  total    Float

  // Void tracking
  voidedAt   DateTime?
  voidedById String? // who voided it
  voidReason String?

  // Combine tracking
  // Parent = the new combined receipt
  // Children = the source receipts that were merged
  parentReceiptId String? // set on source receipts when combined
  combinedAt      DateTime?

  // Duplicate tracking
  originalReceiptId String? // set when this is a reprint

  note          String?
  printCount    Int       @default(0)
  lastPrintedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  order    Order?    @relation(fields: [orderId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  voidedBy User?     @relation("ReceiptVoidedBy", fields: [voidedById], references: [id])

  // Self-relations for combine/duplicate
  parentReceipt   Receipt?  @relation("ReceiptCombine", fields: [parentReceiptId], references: [id])
  childReceipts   Receipt[] @relation("ReceiptCombine")
  originalReceipt Receipt?  @relation("ReceiptDuplicate", fields: [originalReceiptId], references: [id])
  duplicates      Receipt[] @relation("ReceiptDuplicate")

  // Line items snapshot (denormalised — receipts are immutable records)
  items ReceiptItem[]

  @@unique([receiptNumber, branchId])
  @@index([branchId, createdAt])
  @@index([status])
}

model ReceiptItem {
  id          String  @id @default(cuid())
  receiptId   String
  productId   String?
  productName String
  sku         String
  quantity    Int
  unitPrice   Float
  total       Float

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

model Supplier {
  id          String         @id @default(cuid())
  name        String
  email       String?
  phone       String?
  address     String?
  contactName String?
  taxPin      String? // KRA PIN for Kenyan suppliers
  notes       String?
  status      SupplierStatus @default(ACTIVE)
  branchId    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  branch           Branch?           @relation(fields: [branchId], references: [id])
  purchases        Purchase[]
  accountsPayables AccountsPayable[]

  @@index([branchId])
}

model Purchase {
  id             String                @id @default(cuid())
  purchaseNumber String
  supplierId     String?
  branchId       String?
  userId         String? // who created it
  status         PurchaseStatus        @default(DRAFT)
  paymentStatus  PurchasePaymentStatus @default(UNPAID)
  paymentMethod  ExpensePaymentMethod?

  // Invoice details
  invoiceNumber String? // supplier's invoice number
  invoiceDate   DateTime?
  expectedDate  DateTime? // expected delivery date
  receivedDate  DateTime? // actual delivery date

  // Financials
  subtotal       Float @default(0) // sum of items (excl tax)
  taxAmount      Float @default(0) // total tax on purchase
  discountAmount Float @default(0) // order-level discount
  shippingCost   Float @default(0)
  total          Float @default(0) // final total (incl tax + shipping - discount)
  amountPaid     Float @default(0)
  balanceDue     Float @default(0)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier Supplier?         @relation(fields: [supplierId], references: [id])
  branch   Branch?           @relation(fields: [branchId], references: [id])
  user     User?             @relation(fields: [userId], references: [id])
  items    PurchaseItem[]
  payments PurchasePayment[]

  @@unique([purchaseNumber, branchId])
  @@index([branchId, status])
}

model PurchaseItem {
  id              String  @id @default(cuid())
  purchaseId      String
  productId       String?
  productName     String // snapshot — product may change
  sku             String
  orderedQty      Int // quantity ordered
  receivedQty     Int     @default(0) // quantity actually received
  unitCostExcl    Float // unit cost excluding tax
  unitCostIncl    Float // unit cost including tax
  taxRate         Float   @default(0)
  taxAmount       Float   @default(0)
  subtotal        Float // orderedQty × unitCostExcl
  total           Float // orderedQty × unitCostIncl
  // Update product cost price on receive?
  updateCostPrice Boolean @default(true)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id])
}

model PurchasePayment {
  id         String               @id @default(cuid())
  purchaseId String
  amount     Float
  method     ExpensePaymentMethod
  reference  String? // cheque no, mpesa ref, etc.
  note       String?
  paidAt     DateTime             @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

// ── Quotation ─────────────────────────────────────────────────────────────────

model Quotation {
  id              String  @id @default(cuid())
  quotationNumber String
  customerId      String?
  branchId        String?
  userId          String? // Salesperson

  status     QuotationStatus @default(DRAFT)
  validUntil DateTime?
  notes      String?

  subtotal Float @default(0)
  discount Float @default(0)
  tax      Float @default(0)
  total    Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    Customer?       @relation(fields: [customerId], references: [id])
  branch      Branch?         @relation(fields: [branchId], references: [id])
  user        User?           @relation(fields: [userId], references: [id])
  items       QuotationItem[]
  salesOrders SalesOrder[] // A quotation can become a Sales Order

  @@unique([quotationNumber, branchId])
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  productId   String?
  productName String
  sku         String
  quantity    Int
  unitPrice   Float
  discount    Float   @default(0)
  taxRate     Float   @default(0)
  total       Float

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])
}

// ── Sales Order ───────────────────────────────────────────────────────────────

model SalesOrder {
  id          String  @id @default(cuid())
  orderNumber String
  customerId  String?
  branchId    String?
  userId      String?
  quotationId String? // Link back to quotation

  status       SalesOrderStatus @default(DRAFT)
  orderDate    DateTime         @default(now())
  expectedDate DateTime?

  subtotal Float @default(0)
  discount Float @default(0)
  tax      Float @default(0)
  total    Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer  Customer?  @relation(fields: [customerId], references: [id])
  branch    Branch?    @relation(fields: [branchId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])

  items         SalesOrderItem[]
  deliveryNotes DeliveryNote[]
  invoices      Invoice[]

  @@unique([orderNumber, branchId])
}

model SalesOrderItem {
  id           String  @id @default(cuid())
  salesOrderId String
  productId    String?
  productName  String
  sku          String
  quantity     Int
  unitPrice    Float
  discount     Float   @default(0)
  taxRate      Float   @default(0)
  total        Float
  deliveredQty Int     @default(0) // Track partial deliveries

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id])
}

// ── Delivery Note ─────────────────────────────────────────────────────────────

model DeliveryNote {
  id             String  @id @default(cuid())
  deliveryNumber String
  salesOrderId   String
  branchId       String?
  userId         String?

  status       DeliveryStatus @default(PENDING)
  deliveryDate DateTime?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrder SalesOrder         @relation(fields: [salesOrderId], references: [id])
  branch     Branch?            @relation(fields: [branchId], references: [id])
  user       User?              @relation(fields: [userId], references: [id])
  items      DeliveryNoteItem[]

  @@unique([deliveryNumber, branchId])
}

model DeliveryNoteItem {
  id             String  @id @default(cuid())
  deliveryNoteId String
  productId      String?
  productName    String
  sku            String
  quantity       Int

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id])
}

// ── Invoice ───────────────────────────────────────────────────────────────────

model Invoice {
  id            String  @id @default(cuid())
  invoiceNumber String
  salesOrderId  String?
  customerId    String?
  branchId      String?
  userId        String?

  status    InvoiceStatus @default(DRAFT)
  issueDate DateTime      @default(now())
  dueDate   DateTime

  subtotal   Float @default(0)
  discount   Float @default(0)
  tax        Float @default(0)
  total      Float @default(0)
  amountPaid Float @default(0)
  balance    Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id])
  customer   Customer?   @relation(fields: [customerId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])

  items              InvoiceItem[]
  payments           InvoicePayment[]
  accountsReceivable AccountsReceivable[]

  @@unique([invoiceNumber, branchId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String?
  productName String
  sku         String
  quantity    Int
  unitPrice   Float
  discount    Float   @default(0)
  taxRate     Float   @default(0)
  total       Float

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

model InvoicePayment {
  id        String        @id @default(cuid())
  invoiceId String
  amount    Float
  method    PaymentMethod
  reference String?
  paidAt    DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ── Sales Returns ─────────────────────────────────────────────────────────────

model SalesReturn {
  id           String  @id @default(cuid())
  returnNumber String
  salesOrderId String?
  invoiceId    String?
  customerId   String?
  branchId     String?
  userId       String?

  status     SalesReturnStatus @default(PENDING)
  reason     String?
  returnDate DateTime          @default(now())

  subtotal Float @default(0)
  tax      Float @default(0)
  total    Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer?         @relation(fields: [customerId], references: [id])
  branch   Branch?           @relation(fields: [branchId], references: [id])
  user     User?             @relation(fields: [userId], references: [id])
  items    SalesReturnItem[]

  @@unique([returnNumber, branchId])
}

model SalesReturnItem {
  id            String  @id @default(cuid())
  salesReturnId String
  productId     String?
  productName   String
  sku           String
  quantity      Int
  unitPrice     Float
  total         Float

  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id])
}

// Accounting

model Accounting {
  id            String        @id @default(cuid())
  code          String // e.g. "1000", "4000"
  name          String // e.g. "Cash", "Sales Revenue"
  type          AccountType
  normalBalance NormalBalance
  description   String?
  parentId      String? // for sub-accounts
  isActive      Boolean       @default(true)
  isSystem      Boolean       @default(false) // system accounts can't be deleted
  branchId      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  branch   Branch?            @relation(fields: [branchId], references: [id])
  parent   Accounting?        @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Accounting[]       @relation("AccountHierarchy")
  lines    JournalEntryLine[]

  @@unique([code, branchId])
  @@index([type])
}

model JournalEntry {
  id           String             @id @default(cuid())
  entryNumber  String // e.g. "JE-2025-0001"
  date         DateTime
  description  String
  reference    String? // external ref (invoice #, receipt #)
  status       JournalEntryStatus @default(DRAFT)
  source       JournalEntrySource @default(MANUAL)
  sourceId     String? // id of the order/purchase/expense
  branchId     String?
  userId       String?
  postedAt     DateTime?
  postedById   String?
  reversedAt   DateTime?
  reversedById String?
  reversalOfId String? // links to the entry this reverses
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  branch            Branch?            @relation(fields: [branchId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])
  postedBy          User?              @relation("JournalPostedBy", fields: [postedById], references: [id])
  reversedBy        User?              @relation("JournalReversedBy", fields: [reversedById], references: [id])
  reversalOf        JournalEntry?      @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedByEntries JournalEntry[]     @relation("JournalReversal")
  lines             JournalEntryLine[]

  @@unique([entryNumber, branchId])
  @@index([date, status])
  @@index([source, sourceId])
}

model JournalEntryLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Float    @default(0)
  credit         Float    @default(0)
  description    String?
  createdAt      DateTime @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Accounting   @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([journalEntryId])
}

// Track outstanding customer invoices
model AccountsReceivable {
  id            String   @id @default(cuid())
  customerId    String
  invoiceNumber String   @unique
  amount        Float
  amountPaid    Float    @default(0)
  balance       Float
  dueDate       DateTime
  status        String   @default("UNPAID") // UNPAID, PARTIAL, PAID, OVERDUE
  branchId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer  Customer    @relation(fields: [customerId], references: [id])
  branch    Branch?     @relation(fields: [branchId], references: [id])
  payments  ARPayment[]
  invoice   Invoice?    @relation(fields: [invoiceId], references: [id])
  invoiceId String?
}

model ARPayment {
  id             String        @id @default(cuid())
  arId           String
  amount         Float
  paymentDate    DateTime      @default(now())
  method         PaymentMethod
  reference      String? // Mpesa ref, cheque no
  journalEntryId String? // Link to the GL entry

  accountsReceivable AccountsReceivable @relation(fields: [arId], references: [id])
}

// Track bills you owe to suppliers
model AccountsPayable {
  id         String   @id @default(cuid())
  supplierId String
  billNumber String   @unique
  amount     Float
  amountPaid Float    @default(0)
  balance    Float
  dueDate    DateTime
  status     String   @default("UNPAID") // UNPAID, PARTIAL, PAID, OVERDUE
  branchId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier    @relation(fields: [supplierId], references: [id])
  branch   Branch?     @relation(fields: [branchId], references: [id])
  payments APPayment[]
}

model APPayment {
  id             String               @id @default(cuid())
  apId           String
  amount         Float
  paymentDate    DateTime             @default(now())
  method         ExpensePaymentMethod
  reference      String?
  journalEntryId String?

  accountsPayable AccountsPayable @relation(fields: [apId], references: [id])
}

// Fixed Assets and Depreciation

model FixedAsset {
  id                      String   @id @default(cuid())
  name                    String
  assetCode               String   @unique
  category                String // IT, VEHICLE, FURNITURE
  purchaseDate            DateTime
  purchaseCost            Float
  salvageValue            Float    @default(0)
  usefulLifeYears         Int
  depreciationMethod      String   @default("STRAIGHT_LINE") // STRAIGHT_LINE, REDUCING_BALANCE
  accumulatedDepreciation Float    @default(0)
  currentBookValue        Float
  status                  String   @default("ACTIVE") // ACTIVE, DISPOSED, FULLY_DEPRECIATED
  branchId                String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  branch           Branch?           @relation(fields: [branchId], references: [id])
  depreciationLogs DepreciationLog[]
}

model DepreciationLog {
  id             String   @id @default(cuid())
  fixedAssetId   String
  amount         Float
  date           DateTime @default(now())
  journalEntryId String? // Link to the GL entry

  fixedAsset FixedAsset @relation(fields: [fixedAssetId], references: [id])
}

// Bank Reconciliation
model BankAccount {
  id             String  @id @default(cuid())
  accountName    String
  accountNumber  String  @unique
  bankName       String
  currency       String  @default("KES")
  currentBalance Float   @default(0)
  branchId       String?
  accountingId   String? // Link to the GL Account (e.g., 1010 Bank)

  branch          Branch?              @relation(fields: [branchId], references: [id])
  reconciliations BankReconciliation[]
}

model BankReconciliation {
  id             String   @id @default(cuid())
  bankAccountId  String
  statementDate  DateTime
  openingBalance Float
  closingBalance Float
  status         String   @default("DRAFT") // DRAFT, COMPLETED
  createdAt      DateTime @default(now())

  bankAccount BankAccount              @relation(fields: [bankAccountId], references: [id])
  lines       BankReconciliationLine[]
}

model BankReconciliationLine {
  id               String  @id @default(cuid())
  reconciliationId String
  journalEntryId   String? // Match to a GL entry
  description      String
  amount           Float
  isReconciled     Boolean @default(false)

  reconciliation BankReconciliation @relation(fields: [reconciliationId], references: [id])
}

// ── Asset Management ────────────────────────────────────────────────────────────────

model Asset {
  id               String   @id @default(cuid())
  name             String
  category         String // IT, VEHICLE, FURNITURE
  purchaseDate     DateTime
  purchaseCost     Float
  currentValue     Float
  depreciationRate Float    @default(0)
  status           String   @default("ACTIVE") // ACTIVE, MAINTENANCE, DISPOSED
  branchId         String?
  assignedToId     String?

  branch            Branch?            @relation(fields: [branchId], references: [id])
  assignedTo        User?              @relation(fields: [assignedToId], references: [id])
  assetMaintenances AssetMaintenance[]
}

model AssetMaintenance {
  id          String   @id @default(cuid())
  assetId     String
  description String
  cost        Float
  date        DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id])
}

// ── Project Management ────────────────────────────────────────────────────────────────

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  budget      Float     @default(0)
  status      String    @default("ACTIVE") // PLANNING, ACTIVE, COMPLETED
  branchId    String?

  tasks ProjectTask[]
}

model ProjectTask {
  id           String    @id @default(cuid())
  projectId    String
  title        String
  assignedToId String?
  status       String    @default("TODO") // TODO, IN_PROGRESS, DONE
  dueDate      DateTime?

  project    Project @relation(fields: [projectId], references: [id])
  assignedTo User?   @relation(fields: [assignedToId], references: [id])
}

// ── Project Management ────────────────────────────────────────────────────────────────

model Document {
  id           String  @id @default(cuid())
  name         String
  fileUrl      String
  fileType     String
  version      Int     @default(1)
  branchId     String?
  uploadedById String?

  branch     Branch? @relation(fields: [branchId], references: [id])
  uploadedBy User?   @relation(fields: [uploadedById], references: [id])
}

model ApprovalRequest {
  id            String   @id @default(cuid())
  type          String // LEAVE, PURCHASE_ORDER, EXPENSE, SALARY_CHANGE
  referenceId   String // ID of the related record
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedById String
  approvedById  String?
  comments      String?
  createdAt     DateTime @default(now())

  requestedBy User  @relation("ApprovalRequester", fields: [requestedById], references: [id])
  approvedBy  User? @relation("ApprovalApprover", fields: [approvedById], references: [id])
}
